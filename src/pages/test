/* ----------------- Filter Sidebar ----------------- */

interface FilterSidebarProps {
  filtersOpen: boolean;
  setFiltersOpen: React.Dispatch<React.SetStateAction<boolean>>;
  categories: string[];
  pendingColors: string[];
  pendingSizes: string[];
  pendingDressStyle: string;
  pendingPriceRange: { min: number; max: number };
  setPendingPriceRange: React.Dispatch<
    React.SetStateAction<{ min: number; max: number }>
  >;
  setPendingColors: React.Dispatch<React.SetStateAction<string[]>>;
  setPendingSizes: React.Dispatch<React.SetStateAction<string[]>>;
  setPendingDressStyle: React.Dispatch<React.SetStateAction<string>>;
  onApply: () => void;
  onClear: () => void;
}

function FilterSidebar({
  filtersOpen,
  setFiltersOpen,
  categories,
  pendingColors,
  pendingSizes,
  pendingDressStyle,
  pendingPriceRange,
  setPendingPriceRange,
  setPendingColors,
  setPendingSizes,
  setPendingDressStyle,
  onApply,
  onClear,
}: FilterSidebarProps) {
  const colors = [
    "#00C12B",
    "#F50606",
    "#F5DD00",
    "#F57900",
    "#00C2EE",
    "#2F45FF",
    "#7D00FF",
    "#F000A8",
    "#FFFFFF",
    "#000000",
  ];

  const sizes = [
    "XX-Small",
    "X-Small",
    "Small",
    "Medium",
    "Large",
    "X-Large",
    "XX-Large",
    "3X-Large",
    "4X-Large",
  ];

  const dressStyles = ["Casual", "Formal", "Party", "Gym"];

  const toggleColor = (color: string) => {
    setPendingColors((current) =>
      current.includes(color)
        ? current.filter((item) => item !== color)
        : [...current, color]
    );
  };

  const toggleSize = (size: string) => {
    setPendingSizes((current) =>
      current.includes(size)
        ? current.filter((item) => item !== size)
        : [...current, size]
    );
  };

  const handleMinChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const value = Number(e.target.value);
    setPendingPriceRange((current) => ({
      ...current,
      min: Math.min(value, current.max - 1),
    }));
  };

  const handleMaxChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const value = Number(e.target.value);
    setPendingPriceRange((current) => ({
      ...current,
      max: Math.max(value, current.min + 1),
    }));
  };

  // For visual slider bar
  const leftPercent =
    ((pendingPriceRange.min - MIN_PRICE) / (MAX_PRICE - MIN_PRICE)) * 100;
  const rightPercent =
    100 - ((pendingPriceRange.max - MIN_PRICE) / (MAX_PRICE - MIN_PRICE)) * 100;

  return (
    <div className="rounded-[20px] border border-black/10 bg-white p-4">
      {/* Filter Heading */}
      <div className="flex items-center justify-between">
        <h2 className="font-satoshi text-base font-bold">Filters</h2>
        <button
          type="button"
          onClick={() => setFiltersOpen(!filtersOpen)}
          className="text-black/50"
        >
          <FaSliders size={15} />
        </button>
      </div>

      {filtersOpen && (
        <div className="mt-5">
          {/* Categories */}
          <FilterSection title="Categories">
            {categories.map((item) => (
              <Link
                key={item}
                to={`/category/${item.toLowerCase()}`}
                className="flex items-center justify-between py-1.5 text-xs text-black/50 transition hover:text-black"
              >
                <span>{item}</span>
                <span>›</span>
              </Link>
            ))}
          </FilterSection>

          {/* Price */}
          <FilterSection title="Price">
            <div className="px-1 pt-2">
              <div className="relative h-1 rounded-full bg-black/10">
                <div
                  className="absolute h-1 rounded-full bg-black"
                  style={{ left: `${leftPercent}%`, right: `${rightPercent}%` }}
                />
                <div
                  className="absolute top-1/2 h-4 w-4 -translate-y-1/2 rounded-full border-2 border-white bg-black shadow"
                  style={{ left: `${leftPercent}%` }}
                />
                <div
                  className="absolute top-1/2 h-4 w-4 -translate-y-1/2 rounded-full border-2 border-white bg-black shadow"
                  style={{ right: `${rightPercent}%` }}
                />
              </div>

              <div className="mt-4 flex justify-between text-xs">
                <span>${MIN_PRICE}</span>
                <span>${MAX_PRICE}</span>
              </div>
            </div>

            <div className="mt-4 grid grid-cols-2 gap-2">
              <input
                type="number"
                value={pendingPriceRange.min}
                onChange={handleMinChange}
                className="w-full rounded-lg bg-[#F0F0F0] px-2 py-2 text-xs outline-none"
              />
              <input
                type="number"
                value={pendingPriceRange.max}
                onChange={handleMaxChange}
                className="w-full rounded-lg bg-[#F0F0F0] px-2 py-2 text-xs outline-none"
              />
            </div>
          </FilterSection>

          {/* Colors */}
          <FilterSection title="Colors">
            <div className="grid grid-cols-5 gap-3">
              {colors.map((color) => {
                const active = pendingColors.includes(color);
                return (
                  <button
                    key={color}
                    type="button"
                    onClick={() => toggleColor(color)}
                    aria-pressed={active}
                    className={`h-7 w-7 rounded-full border ${color === "#FFFFFF" ? "border-black/20" : "border-transparent"
                      } ${active ? "ring-2 ring-black ring-offset-2" : ""}`}
                    style={{ backgroundColor: color }}
                    aria-label={`Select color ${color}`}
                  />
                );
              })}
            </div>
          </FilterSection>

          {/* Size */}
          <FilterSection title="Size">
            <div className="flex flex-wrap gap-2">
              {sizes.map((size) => {
                const active = pendingSizes.includes(size);
                return (
                  <button
                    key={size}
                    type="button"
                    onClick={() => toggleSize(size)}
                    aria-pressed={active}
                    className={`rounded-full px-3 py-2 text-[10px] transition ${active ? "bg-black text-white" : "bg-[#F0F0F0] text-black/50"
                      }`}
                  >
                    {size}
                  </button>
                );
              })}
            </div>
          </FilterSection>

          {/* Dress Style */}
          <FilterSection title="Dress Style">
            {dressStyles.map((style) => (
              <button
                key={style}
                type="button"
                onClick={() =>
                  setPendingDressStyle(pendingDressStyle === style ? "" : style)
                }
                className={`flex w-full items-center justify-between py-1.5 text-xs transition ${pendingDressStyle === style
                  ? "font-medium text-black"
                  : "text-black/50 hover:text-black"
                  }`}
              >
                <span>{style}</span>
                <span>›</span>
              </button>
            ))}
          </FilterSection>

          {/* Actions */}
          <div className="mt-5 flex flex-col gap-2">
            <button
              type="button"
              onClick={onApply}
              className="h-10 w-full rounded-full bg-black text-xs font-medium text-white transition hover:bg-black/90"
            >
              Apply Filter
            </button>

            <button
              type="button"
              onClick={onClear}
              className="h-10 w-full rounded-full border border-black/10 text-xs font-medium text-black transition hover:bg-black/5"
            >
              Clear All
            </button>
          </div>
        </div>
      )}
    </div>
  );
}

/* ----------------- Filter Section ----------------- */

interface FilterSectionProps {
  title: string;
  children: React.ReactNode;
}

function FilterSection({ title, children }: FilterSectionProps) {
  const [open, setOpen] = useState(true);

  return (
    <div className="border-t border-black/10 py-4 first:border-t-0">
      <button
        type="button"
        onClick={() => setOpen(!open)}
        className="mb-3 flex w-full items-center justify-between"
      >
        <span className="font-satoshi text-sm font-medium">{title}</span>
        {open ? (
          <FaChevronUp size={10} className="text-black/50" />
        ) : (
          <FaChevronDown size={10} className="text-black/50" />
        )}
      </button>
      {open && children}
    </div>
  );
}

/* ----------------- Pagination ----------------- */

interface PaginationProps {
  currentPage: number;
  totalPages: number;
  setCurrentPage: React.Dispatch<React.SetStateAction<number>>;
}

function Pagination({
  currentPage,
  totalPages,
  setCurrentPage,
}: PaginationProps) {
  const pages = Array.from({ length: totalPages }, (_, index) => index + 1);

  return (
    <div className="mt-8 flex items-center justify-between border-t border-black/10 pt-4">
      {/* Previous */}
      <button
        type="button"
        disabled={currentPage === 1}
        onClick={() => setCurrentPage((page) => Math.max(1, page - 1))}
        className="flex items-center gap-2 rounded-lg border border-black/10 px-3 py-2 text-xs transition hover:bg-black hover:text-white disabled:cursor-not-allowed disabled:opacity-40"
      >
        <span>←</span>
        <span>Previous</span>
      </button>

      {/* Pages */}
      <div className="hidden items-center gap-1 sm:flex">
        {pages.map((page) => (
          <button
            key={page}
            type="button"
            onClick={() => setCurrentPage(page)}
            aria-current={currentPage === page ? "page" : undefined}
            className={`h-8 min-w-8 rounded-lg px-2 text-xs ${currentPage === page
              ? "bg-[#F0F0F0] font-medium"
              : "text-black/50 hover:text-black"
              }`}
          >
            {page}
          </button>
        ))}
      </div>

      {/* Mobile Page */}
      <span className="text-xs text-black/50 sm:hidden">
        {currentPage} / {totalPages}
      </span>

      {/* Next */}
      <button
        type="button"
        disabled={currentPage === totalPages}
        onClick={() => setCurrentPage((page) => Math.min(totalPages, page + 1))}
        className="flex items-center gap-2 rounded-lg border border-black/10 px-3 py-2 text-xs transition hover:bg-black hover:text-white disabled:cursor-not-allowed disabled:opacity-40"
      >
        <span>Next</span>
        <span>→</span>
      </button>
    </div>
  );
}











